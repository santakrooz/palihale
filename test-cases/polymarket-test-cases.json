          "test_case_id": "TC-017",
          "title": "Smart Contract Authorization Check",
          "priority": "Critical",
          "status": "Active",
          "type": "Security",
          "preconditions": [
            "User is authenticated",
            "Market exists"
          ],
          "steps": [
            {
              "step_number": 1,
              "action": "Attempt to resolve a market created by another user",
              "expected_result": "Transaction is rejected by smart contract"
            },
            {
              "step_number": 2,
              "action": "Attempt to claim winnings for position not owned",
              "expected_result": "Smart contract reverts transaction"
            },
            {
              "step_number": 3,
              "action": "Verify only authorized users can perform privileged actions",
              "expected_result": "All authorization checks pass"
            }
          ],
          "tags": ["security", "authorization", "smart-contract", "critical"]
