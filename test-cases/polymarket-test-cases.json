          "test_case_id": "TC-016",
          "title": "Wallet Signature Verification",
          "priority": "Critical",
          "status": "Active",
          "type": "Security",
          "preconditions": [
            "User has MetaMask installed"
          ],
          "steps": [
            {
              "step_number": 1,
              "action": "Attempt to connect wallet",
              "expected_result": "Signature request is prompted"
            },
            {
              "step_number": 2,
              "action": "Reject signature in MetaMask",
              "expected_result": "Connection fails gracefully"
            },
            {
              "step_number": 3,
              "action": "Attempt to access authenticated endpoints without signature",
              "expected_result": "Access is denied with 401 error"
            }
          ],
          "tags": ["security", "authentication", "critical"]
        },
