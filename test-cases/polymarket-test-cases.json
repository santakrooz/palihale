      "suite_name": "User Authentication",
      "suite_id": "TS-001",
      "test_cases": [
        {
          "test_case_id": "TC-001",
          "title": "User Registration with Valid Wallet",
          "priority": "High",
          "status": "Active",
          "type": "Functional",
          "preconditions": [
            "User has a compatible Web3 wallet installed (e.g., MetaMask)",
            "User is not already registered"
          ],
          "steps": [
            {
              "step_number": 1,
              "action": "Navigate to the Polymarket clone homepage",
              "expected_result": "Homepage loads successfully"
            },
            {
              "step_number": 2,
              "action": "Click on 'Connect Wallet' button",
              "expected_result": "Wallet connection modal appears"
            },
            {
              "step_number": 3,
              "action": "Select MetaMask and approve connection",
              "expected_result": "Wallet successfully connects and user is registered"
            },
            {
              "step_number": 4,
              "action": "Verify user dashboard is accessible",
              "expected_result": "User is redirected to dashboard with wallet address displayed"
            }
          ],
          "tags": ["authentication", "wallet", "registration", "smoke"]
        },
        {
          "test_case_id": "TC-002",
