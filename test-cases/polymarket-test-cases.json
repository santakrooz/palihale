    {
      "suite_name": "Market Creation",
      "suite_id": "TS-002",
      "test_cases": [
        {
          "test_case_id": "TC-003",
          "title": "Create Binary Market with Valid Parameters",
          "priority": "Critical",
          "status": "Active",
          "type": "Functional",
          "preconditions": [
            "User is authenticated",
            "User has sufficient balance for market creation fee"
          ],
          "steps": [
            {
              "step_number": 1,
              "action": "Navigate to 'Create Market' page",
              "expected_result": "Market creation form is displayed"
            },
            {
              "step_number": 2,
              "action": "Enter market question: 'Will Bitcoin reach $100,000 by end of 2025?'",
              "expected_result": "Question is accepted and validated"
            },
            {
              "step_number": 3,
              "action": "Set market type to 'Binary' (Yes/No)",
              "expected_result": "Binary options are displayed"
            },
            {
              "step_number": 4,
              "action": "Set resolution date to '2025-12-31'",
              "expected_result": "Date is accepted"
            },
            {
              "step_number": 5,
              "action": "Add market category and tags",
              "expected_result": "Category and tags are saved"
            },
            {
              "step_number": 6,
              "action": "Set initial liquidity amount",
              "expected_result": "Liquidity parameters are validated"
            },
            {
              "step_number": 7,
              "action": "Submit market creation",
              "expected_result": "Transaction is sent to blockchain and market is created with unique ID"
            }
          ],
          "tags": ["market", "creation", "binary", "critical"]
        },
        {
          "test_case_id": "TC-004",
          "title": "Create Market with Invalid Resolution Date",
          "priority": "Medium",
          "status": "Active",
          "type": "Negative",
          "preconditions": [
            "User is authenticated"
          ],
          "steps": [
            {
              "step_number": 1,
              "action": "Navigate to 'Create Market' page",
              "expected_result": "Market creation form is displayed"
            },
            {
              "step_number": 2,
              "action": "Enter valid market question",
              "expected_result": "Question is accepted"
            },
            {
              "step_number": 3,
              "action": "Set resolution date to a past date",
              "expected_result": "Error message: 'Resolution date must be in the future'"
            },
            {
              "step_number": 4,
              "action": "Attempt to submit market",
              "expected_result": "Submission is blocked and validation error is shown"
            }
          ],
          "tags": ["market", "creation", "validation", "negative"]
        }
      ]
    },
